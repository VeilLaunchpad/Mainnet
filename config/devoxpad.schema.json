{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devoxpad.local/devoxpad.schema.json",
  "title": "DEVOXPAD master table",
  "description": "Registry of record for one DEVOXPAD deployment: chain params, contract addresses, launch economics, routes, agents and tools. Addresses and public config only - credentials live in .env.local and are never written here.",
  "type": "object",
  "required": ["app", "chain", "contracts", "launch", "routes"],
  "properties": {
    "$schema": { "type": "string" },
    "app": {
      "type": "object",
      "required": ["name", "version", "network"],
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "version": { "type": "string" },
        "network": { "enum": ["testnet", "mainnet"] }
      }
    },
    "chain": {
      "type": "object",
      "required": ["id", "name", "nativeCurrency", "rpc", "explorer"],
      "properties": {
        "id": { "type": "integer", "description": "7082400 for COTI testnet, 2632500 for mainnet." },
        "name": { "type": "string" },
        "nativeCurrency": {
          "type": "object",
          "required": ["symbol", "decimals"],
          "properties": {
            "name": { "type": "string" },
            "symbol": { "type": "string" },
            "decimals": { "type": "integer" }
          }
        },
        "rpc": { "type": "array", "items": { "type": "string", "format": "uri" }, "minItems": 1 },
        "ws": { "type": "array", "items": { "type": "string" } },
        "explorer": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "name": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "tx": { "type": "string" },
            "address": { "type": "string" },
            "token": { "type": "string" }
          }
        },
        "faucet": { "type": "object" },
        "bridge": { "type": "object" }
      }
    },
    "deployer": {
      "type": "object",
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "funded": { "type": "boolean" },
        "envKey": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "contracts": {
      "type": "object",
      "required": ["coti", "devoxpad"],
      "properties": {
        "coti": {
          "type": "object",
          "description": "Deployed and maintained by COTI, not by this project.",
          "additionalProperties": { "$ref": "#/$defs/contractEntry" }
        },
        "devoxpad": {
          "type": "object",
          "description": "Written by contracts/scripts/deploy.ts.",
          "additionalProperties": { "$ref": "#/$defs/contractEntry" }
        },
        "uniswapV3": {
          "type": "object",
          "description": "External. DEVOXPAD speaks the standard V3 interfaces and reads these from env."
        }
      }
    },
    "launch": { "type": "object", "description": "Bonding-curve tuning and graduation rules." },
    "routes": { "type": "object", "additionalProperties": { "type": "string" } },
    "api": { "type": "object" },
    "agents": { "type": "object", "description": "Regenerated by scripts/build-master-table.mjs." },
    "tools": { "type": "object", "description": "Regenerated by scripts/build-master-table.mjs." },
    "services": { "type": "object", "description": "Base URLs and the env key holding each credential - never the credential itself." },
    "storage": { "type": "object" },
    "privacy": { "type": "object" },
    "deployedAt": { "type": "string", "format": "date-time" },
    "deployedChainId": { "type": "integer" }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "contractEntry": {
      "type": "object",
      "required": ["address", "status"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "status": {
          "enum": ["deployed", "pending", "per-token", "external"],
          "description": "'pending' makes the UI degrade to a clear not-deployed state instead of reverting. 'per-token' means one instance exists per launch, not a singleton."
        },
        "role": { "type": "string" },
        "envKey": { "type": ["string", "null"] },
        "abi": { "type": "string", "description": "Exported name in src/lib/abis.ts." },
        "deployOrder": { "type": "integer" }
      }
    }
  }
}
