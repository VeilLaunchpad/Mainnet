# ─────────────────────────────────────────────────────────────
#  DEVOXPAD - environment
#  Everything here is SERVER-SIDE unless prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# ---- COTI network -------------------------------------------------
NEXT_PUBLIC_COTI_NETWORK=testnet
NEXT_PUBLIC_COTI_MAINNET_RPC=https://mainnet.coti.io/rpc
NEXT_PUBLIC_COTI_TESTNET_RPC=https://testnet.coti.io/rpc
NEXT_PUBLIC_COTI_MAINNET_WS=wss://mainnet.coti.io/ws
NEXT_PUBLIC_COTI_TESTNET_WS=wss://testnet.coti.io/ws

# ---- DEVOXPAD deployed contracts (fill after `npm run deploy`) ------
NEXT_PUBLIC_DEVOX_FACTORY_TESTNET=
NEXT_PUBLIC_DEVOX_CURVE_TESTNET=
NEXT_PUBLIC_AGENT_REGISTRY_TESTNET=
NEXT_PUBLIC_PROFILE_REGISTRY_TESTNET=
NEXT_PUBLIC_DEVOX_FACTORY_MAINNET=
NEXT_PUBLIC_DEVOX_CURVE_MAINNET=
NEXT_PUBLIC_AGENT_REGISTRY_MAINNET=
NEXT_PUBLIC_PROFILE_REGISTRY_MAINNET=

# ---- Uniswap V3 (COTI deployment) ---------------------------------
NEXT_PUBLIC_UNIV3_FACTORY_TESTNET=
NEXT_PUBLIC_UNIV3_ROUTER_TESTNET=
NEXT_PUBLIC_UNIV3_POSITION_MANAGER_TESTNET=
NEXT_PUBLIC_UNIV3_QUOTER_TESTNET=
NEXT_PUBLIC_WCOTI_TESTNET=
NEXT_PUBLIC_UNIV3_FACTORY_MAINNET=
NEXT_PUBLIC_UNIV3_ROUTER_MAINNET=
NEXT_PUBLIC_UNIV3_POSITION_MANAGER_MAINNET=
NEXT_PUBLIC_UNIV3_QUOTER_MAINNET=
NEXT_PUBLIC_WCOTI_MAINNET=

# ---- COTI official contracts --------------------------------------
NEXT_PUBLIC_PRIVATE_MESSAGING_TESTNET=0xa4C514225Db5B8AE6eF1548d4CE912234A7CD954
NEXT_PUBLIC_PRIVATE_MESSAGING_MAINNET=0xe461F448cB935a14585F6f1a30F5b4C73ffF8c05
NEXT_PUBLIC_ACCOUNT_ONBOARD_TESTNET=0x536A67f0cc46513E7d27a370ed1aF9FDcC7A5095

# ---- Agent operator key (server-side signer for autonomous agents) -
# Leave blank to run agents in "advisory" (read-only) mode.
AGENT_PRIVATE_KEY=
AGENT_AES_KEY=

# ---- AI BRAIN - LLM pool (OpenAI-compatible), tried in order -------
LLM_POOL=
LLM_PRESETS=groq=https://api.groq.com/openai/v1,gemini=https://generativelanguage.googleapis.com/v1beta/openai,cerebras=https://api.cerebras.ai/v1,mistral=https://api.mistral.ai/v1,openrouter=https://openrouter.ai/api/v1,deepseek=https://api.deepseek.com/v1,together=https://api.together.xyz/v1,openai=https://api.openai.com/v1

# ---- Web search (Exa), falls back to DuckDuckGo --------------------
EXA_KEYS=
EXA_SEARCH_URL=https://api.exa.ai/search
EXA_CHAT_URL=https://api.exa.ai/chat/completions
EXA_MODEL=exa

# ---- Bridge (Relay) ------------------------------------------------
RELAY_API_BASE=https://api.relay.link
RELAY_API_KEY=
NEXT_PUBLIC_COTI_BRIDGE_URL=https://bridge.coti.io

# ---- IPFS (Pinata) - token logos & agent avatars -------------------
PINATA_JWT=
PINATA_BASE=https://api.pinata.cloud
NEXT_PUBLIC_PINATA_GATEWAY=https://ipfs.io/ipfs/

# ---- Market data ---------------------------------------------------
COINGECKO_KEY=
COINGECKO_BASE=https://api.coingecko.com/api/v3
GT_BASE=https://api.geckoterminal.com/api/v2
DEXSCREENER_BASE=https://api.dexscreener.com

# ---- EVM data / explorer ------------------------------------------
MORALIS_API_KEY=
MORALIS_BASE=https://deep-index.moralis.io/api/v2.2

# ---- NFT stack (two factories, marketplace, staking, Genesis) ------
# Public contract addresses only. Deploy with:
#   npx hardhat run scripts/deploy-nft.ts --network cotiMainnet
#   npx hardhat run scripts/deploy-editions.ts --network cotiMainnet
NEXT_PUBLIC_NFT_FACTORY_TESTNET=
NEXT_PUBLIC_NFT_FACTORY_MAINNET=
NEXT_PUBLIC_NFT_EDITIONS_FACTORY_TESTNET=
NEXT_PUBLIC_NFT_EDITIONS_FACTORY_MAINNET=
NEXT_PUBLIC_NFT_MARKET_TESTNET=
NEXT_PUBLIC_NFT_MARKET_MAINNET=
NEXT_PUBLIC_NFT_STAKING_TESTNET=
NEXT_PUBLIC_NFT_STAKING_MAINNET=
NEXT_PUBLIC_NFT_GENESIS_TESTNET=
NEXT_PUBLIC_NFT_GENESIS_MAINNET=

# ---- App -----------------------------------------------------------
NEXT_PUBLIC_APP_NAME=DEVOXPAD
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Telegram bridge -----------------------------------------------
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT=DevoxPadBot
