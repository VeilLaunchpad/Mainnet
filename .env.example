# Copy to .env and fill in the blanks.
#
# Every blank is a credential and must never be committed. The NEXT_PUBLIC_*
# addresses are filled in with what is actually deployed, so a fresh clone
# reaches the live contracts without deploying anything.
#
# Values are kept only where they are provably safe: a public address, a bare
# endpoint, or a plain word. Everything else is blanked, because a list of
# things to hide only catches the ones you thought of.

# ---------------------------------------------------------------------------
# VEILPAD on Railway
#
# This file is committed on purpose. The repository is private, and the whole
# point of this deployment is that it boots with no console fiddling. If the
# repository ever stops being private, every value below has to be rotated,
# because a committed secret is only as private as the place it is committed.
#
# Anything set in the Railway dashboard overrides what is here, so a single
# value can be rotated without touching the repo.
# ---------------------------------------------------------------------------

# ─────────────────────────────────────────────────────────────
#  VEILPAD - environment
#  Everything here is SERVER-SIDE unless prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# ---- COTI network -------------------------------------------------
NEXT_PUBLIC_COTI_NETWORK=mainnet
NEXT_PUBLIC_COTI_MAINNET_RPC=https://mainnet.coti.io/rpc
NEXT_PUBLIC_COTI_TESTNET_RPC=https://testnet.coti.io/rpc
NEXT_PUBLIC_COTI_MAINNET_WS=wss://mainnet.coti.io/ws
NEXT_PUBLIC_COTI_TESTNET_WS=wss://testnet.coti.io/ws

# ---- VEILPAD deployed contracts (fill after `npm run deploy`) ------
NEXT_PUBLIC_VEIL_FACTORY_TESTNET=0xEaE25c294E12be6E458A881013C92c30dcda1614
NEXT_PUBLIC_VEIL_CURVE_TESTNET=
NEXT_PUBLIC_AGENT_REGISTRY_TESTNET=0x4472a6A2175CA298028994eE458391614Ac92722
NEXT_PUBLIC_PROFILE_REGISTRY_TESTNET=0x837d1d1331a0a0598b3DCffA484B78bC6eCd6c0D
NEXT_PUBLIC_VEIL_FACTORY_MAINNET=0xc0D9E704071341896b3B0BBCedF242A16B363773
NEXT_PUBLIC_VEIL_CURVE_MAINNET=
NEXT_PUBLIC_AGENT_REGISTRY_MAINNET=0x4Bcb7a7B9F0EED49db398D8CA154d9C34d0ffc30
NEXT_PUBLIC_PROFILE_REGISTRY_MAINNET=0xA9CE252fdCc8f96325627F985B578dbb7515B0dc

# ---- Uniswap V3 (COTI deployment) ---------------------------------
NEXT_PUBLIC_UNIV3_FACTORY_TESTNET=
NEXT_PUBLIC_UNIV3_ROUTER_TESTNET=
NEXT_PUBLIC_UNIV3_POSITION_MANAGER_TESTNET=
NEXT_PUBLIC_UNIV3_QUOTER_TESTNET=
NEXT_PUBLIC_WCOTI_TESTNET=0x9569C225F4EBa6efcd73f5421F5A5126b566ed03
NEXT_PUBLIC_UNIV3_FACTORY_MAINNET=
NEXT_PUBLIC_UNIV3_ROUTER_MAINNET=
NEXT_PUBLIC_UNIV3_POSITION_MANAGER_MAINNET=
NEXT_PUBLIC_UNIV3_QUOTER_MAINNET=
NEXT_PUBLIC_WCOTI_MAINNET=0xA406b1569eabEDCF503645e9C25cbcdBF03200Ab

# ---- COTI official contracts --------------------------------------
NEXT_PUBLIC_PRIVATE_MESSAGING_TESTNET=0xa4C514225Db5B8AE6eF1548d4CE912234A7CD954
NEXT_PUBLIC_PRIVATE_MESSAGING_MAINNET=0xe461F448cB935a14585F6f1a30F5b4C73ffF8c05
NEXT_PUBLIC_ACCOUNT_ONBOARD_TESTNET=0x536A67f0cc46513E7d27a370ed1aF9FDcC7A5095

# ---- Agent operator key (server-side signer for autonomous agents) -
# Leave blank to run agents in "advisory" (read-only) mode.
AGENT_PRIVATE_KEY=
AGENT_AES_KEY=

# ---- AI BRAIN - LLM pool (OpenAI-compatible), tried in order -------
LLM_POOL=
LLM_PRESETS=

# ---- Web search (Exa), falls back to DuckDuckGo --------------------
EXA_KEYS=
EXA_SEARCH_URL=https://api.exa.ai/search
EXA_CHAT_URL=https://api.exa.ai/chat/completions
EXA_MODEL=exa

# ---- Bridge (Relay) ------------------------------------------------
RELAY_API_BASE=https://api.relay.link
RELAY_API_KEY=
NEXT_PUBLIC_COTI_BRIDGE_URL=https://bridge.coti.io

# ---- IPFS (Pinata) - token logos & agent avatars -------------------
PINATA_JWT=
PINATA_BASE=https://api.pinata.cloud
NEXT_PUBLIC_PINATA_GATEWAY=https://ipfs.io/ipfs/

# ---- Market data ---------------------------------------------------
COINGECKO_KEY=
COINGECKO_BASE=https://api.coingecko.com/api/v3
GT_BASE=https://api.geckoterminal.com/api/v2
DEXSCREENER_BASE=https://api.dexscreener.com

# ---- EVM data / explorer ------------------------------------------
MORALIS_API_KEY=
MORALIS_BASE=https://deep-index.moralis.io/api/v2.2

# ---- App -----------------------------------------------------------
NEXT_PUBLIC_APP_NAME=VEILPAD
# Resolved at runtime from RAILWAY_PUBLIC_DOMAIN. Set this only to pin a custom domain.
# The address shown to people: docs, share links, anything copied by hand.
# Kept separate from the origin, which Telegram and server-side fetches use.
NEXT_PUBLIC_SITE_URL=https://veilpad-app.vercel.app

NEXT_PUBLIC_APP_URL=

# ---- Deployer (funded via the COTI faucet, used by contracts/) -----
DEPLOYER_PRIVATE_KEY=
NEXT_PUBLIC_SWAP_FACTORY_TESTNET=0x401D96dB62E04d2bb31C748e5E3Da16F99Ed317e
NEXT_PUBLIC_SWAP_ROUTER_TESTNET=0x6b02aF47D37a7ce3d472D00598244D803A33Be41
NEXT_PUBLIC_PORTAL_TESTNET=0x6b7a866CA3E7F0A001b0B2e2e3D462Ad1963A466
NEXT_PUBLIC_LOCKER_TESTNET=0x1e8b8188F0F6e6f2c83Ca9b2bf93ba41C8eF6f4a

# ---- Telegram bridge -----------------------------------------------
# The bot reads and reasons. It never holds a key and never signs.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT=VeilPadBot
# ---------------------------------------------------------------------------
# Railway runtime
# ---------------------------------------------------------------------------

# Left blank on purpose. When a volume is attached, Railway sets
# RAILWAY_VOLUME_MOUNT_PATH and the app writes its database there instead of
# into the container, which is wiped on every deploy.
VEILPAD_DATA_DIR=
# ---------------------------------------------------------------------------
# Object storage (Railway bucket)
#
# Holds rolling snapshots of the SQLite index, so the data survives a lost or
# replaced volume rather than only a redeploy. On boot the app restores from
# here only when the disk is empty; it never overwrites a database that exists.
# ---------------------------------------------------------------------------
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_SWAP_FACTORY_MAINNET=0x9B6b892d89F1AC96A06a768f6D4dDb9A50Cd689c
NEXT_PUBLIC_SWAP_ROUTER_MAINNET=0x8C464A9Ad2E08209f4e92D8c912d9B9467a2d74a
NEXT_PUBLIC_LOCKER_MAINNET=0xB739F0B5506e8f9a29e41aaEb11B458BF9b0B5Df
NEXT_PUBLIC_PORTAL_MAINNET=0xf418A5cFa6f67c4A635A8F9814C98d7AbB72ED8a
NEXT_PUBLIC_VEIL_STAKING_MAINNET=0xEfACd7A94FDf34B5b35965D23d25c1509fa57546
NEXT_PUBLIC_VEIL_STAKING_TESTNET=0x99970943bE35FD228e334b731ca6579ff2D49dd7
NEXT_PUBLIC_VEIL_TOKEN_DEPLOYER_MAINNET=0x8e9540a79494c7bc2182AB2F8DDEd480259389e3
NEXT_PUBLIC_VEIL_TOKEN_DEPLOYER_TESTNET=0xBeeee471b25fFaE7074e3A0D1C5f381fb7E682A8
NEXT_PUBLIC_VEIL_TOKEN_MAINNET=0x11728cBe1734b437723D06Dd137549e05f358888
NEXT_PUBLIC_VEIL_TOKEN_TESTNET=0x2B1080DE29d97fc5591Bd065EA5454679a4E8888
NEXT_PUBLIC_VEIL_TOKEN_TWIN_MAINNET=0xDd5BCc9a17eF61141eaC0a22053A52A9aDFbD434
